# Root .gitignore — subprojects (admin/, api/, app/*) have their own .gitignore files.

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# Environment / secrets (safety net)
.env
.env.*
!.env.example

# Dependencies & build output (safety net)
node_modules/
vendor/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
